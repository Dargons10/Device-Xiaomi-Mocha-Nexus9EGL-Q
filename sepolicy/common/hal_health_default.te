init_daemon_domain(hal_health_default)

# Read access to pseudo filesystems.
r_dir_file(hal_health_default, sysfs_power_supply)
r_dir_file(hal_health_default, sysfs_batteryinfo)
allow hal_health_default sysfs_batteryinfo:file w_file_perms;

# For monitoring battery uevents
allow hal_health_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

