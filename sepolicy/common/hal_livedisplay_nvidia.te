type hal_livedisplay_nvidia, domain;
hal_server_domain(hal_livedisplay_nvidia, hal_lineage_livedisplay)

type hal_livedisplay_nvidia_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_livedisplay_nvidia)

# Allow access to graphics sysfs nodes for LiveDisplay (CMU, etc.)
allow hal_livedisplay_nvidia sysfs_graphics:file rw_file_perms;
allow hal_livedisplay_nvidia sysfs_graphics:dir r_dir_perms;
allow hal_livedisplay_nvidia sysfs_cmu:file rw_file_perms;
