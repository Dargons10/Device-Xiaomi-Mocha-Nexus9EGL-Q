type hal_thermal_default, domain;
hal_server_domain(hal_thermal_default, hal_thermal)

type hal_thermal_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_thermal_default)

# Allow access to thermal sysfs nodes
allow hal_thermal_default sysfs_thermal:dir r_dir_perms;
allow hal_thermal_default sysfs_thermal:file rw_file_perms;
