# Graphics permissions
allow hal_graphics_composer_default tegradc_device:chr_file rw_file_perms;
allow hal_graphics_composer_default gpu_device:chr_file rw_file_perms;
allow surfaceflinger tegradc_device:chr_file rw_file_perms;
allow surfaceflinger gpu_device:chr_file rw_file_perms;
allow surfaceflinger sysfs_graphics:file rw_file_perms;
allow hal_graphics_composer_default sysfs_graphics:file rw_file_perms;

