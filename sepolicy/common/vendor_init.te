allow vendor_init camera_data_file:dir create_dir_perms;
allow vendor_init efs_data_file:dir create_dir_perms;
allow vendor_init gps_data_file:dir create_dir_perms;
allow vendor_init kickstart_data_file:dir create_dir_perms;
allow vendor_init nfc_data_file:dir create_dir_perms;
allow vendor_init tlk_data_file:dir create_dir_perms;

allow vendor_init kernel:process setsched;
allow vendor_init kickstart_data_file:dir setattr;
allow vendor_init self:capability sys_nice;

allow vendor_init camera_data_file:file create_file_perms;
allow vendor_init proc:file write;

# Allow creating and labeling recents and sensor directories in /data/system
allow vendor_init system_data_file:dir { search write add_name create setattr relabelfrom relabelto };
allow vendor_init system_data_file:file { create getattr open read write setattr relabelfrom relabelto };

# Allow vendor_init to relabel property_info
allow vendor_init property_info:file { read relabelfrom };
